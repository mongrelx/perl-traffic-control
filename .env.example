# PTC Configuration
# Copy this file to .env and update the values

# Database Configuration
PTC_DB_HOST=db
PTC_DB_NAME=ptc
PTC_DB_USER=ptc_user
PTC_DB_PASSWORD=changeme

# RADIUS Database Configuration
PTC_RADIUS_DB_HOST=db
PTC_RADIUS_DB_NAME=radius
PTC_RADIUS_DB_USER=radius
PTC_RADIUS_DB_PASSWORD=changeme

# OpenNMS Database Configuration (optional)
PTC_OPENNMS_DB_HOST=localhost
PTC_OPENNMS_DB_NAME=opennms
PTC_OPENNMS_DB_USER=opennms
PTC_OPENNMS_DB_PASSWORD=opennms

# Application Configuration
PTC_REGION=default
PTC_PURPOSE=router
PTC_DEBUG=0

# MySQL Root Password (for Docker)
MYSQL_ROOT_PASSWORD=changeme
