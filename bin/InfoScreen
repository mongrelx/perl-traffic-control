    $app->delForm('Help');
    $selected = 0;
    $w = $app->getForm('Main')->getWidget('lstAuth');
    $app->execute;
}


sub editExit {
    my $f = shift;
    my $key = shift;
    my @fields = qw(MAC RadReply FilterId REDIRECT Notes);
    my %rec;

    return unless $key eq "\n";

    if ($f->getWidget('Buttons')->getField('VALUE') == 1) {
        $app->delForm('Edit');
        $w = $app->getForm('Main')->getWidget('lstAuth');
        $app->execute;
        return;
    }

    # Get field values
    $rec{$_} = $f->getWidget($_)->getField('VALUE') for @fields;

    unless ($rec{RadReply} && $rec{FilterId}) {
        dialog('Error!', BTN_OK, 'Reply-Message & Filter-Id are required!',
               qw(white red yellow));
        return;
    }

    unless ($rec{FilterId} =~ /^\d+\/\d+$/) {
        dialog('Error!', BTN_OK, 'Filter-Id must be in format: upload/download (e.g. 1024/1024)',
               qw(white red yellow));
        return;
    }

    unless ($rec{RadReply} =~ /^\d+\/.*$/) {
        dialog('Error!', BTN_OK, 'Reply-Message must start with client ID (e.g. 123/username)',
               qw(white red yellow));
        return;
    }

    $rec{RadReply} .= "/InfoScreen";

    unless ($Options::dbh_dbase && $Options::dbh_host && $Options::dbh_pass && $Options::dbh_user) {
        dialog('Error!', BTN_OK, 'Database settings not configured!',
               qw(white red yellow));
        return;
    }

    our $main::dbh_hpna = DBI->connect(
        "DBI:mysql:$Options::dbh_dbase:$Options::dbh_host",
        $Options::dbh_user, $Options::dbh_pass
    );
    my $msg = saveClientDevice($rec{MAC}, $rec{FilterId}, $rec{RadReply});

    if ($$msg =~ /^OK/) {
        $app->delForm('Edit');
        $w = $app->getForm('Main')->getWidget('lstAuth');
        $app->execute;
    } else {
        dialog('Error!', BTN_OK, "Save failed: $$msg", qw(white red yellow));
    }
}



sub searchExit {
    my $f = shift;
    my $key = shift;
    my %rec;

    return unless $key eq "\n";

    if ($f->getWidget('Buttons')->getField('VALUE') == 1) {
        $app->delForm('Search');
        $w = $app->getForm('Main')->getWidget('lstConn');
        $app->execute;
        return;
    }

    $rec{SearchStr} = $f->getWidget('SearchStr')->getField('VALUE');
    $rec{SiteStr}   = $f->getWidget('SiteStr')->getField('VALUE');

    my $search_term;
    my $search_db = 0;

    if (defined $rec{SearchStr} && $rec{SearchStr} ne '') {
        $search_term = $rec{SearchStr};
        $search_db = 0;
    } elsif (defined $rec{SiteStr} && $rec{SiteStr} ne '') {
        $search_term = $rec{SiteStr};
        $search_db = 1;
    } else {
        dialog('Error!', BTN_OK, 'Search string or Site-ID required!',
               qw(white red yellow));
        return;
    }

    $app->delForm('Search');
    $w = $app->getForm('Main')->getWidget('lstConn');
    $database = $search_db;
    my $ref_tmp = loaddir($current_order, $search_term, 1, $database);
    @tmp2 = @$ref_tmp if ref $ref_tmp eq 'ARRAY';
    $view = $search_term;
    $w->setField(
        CAPTION   => "$search_term Found: " . scalar(@tmp2) . " $main::users_string",
        LISTITEMS => [@tmp2],
    );
    $app->execute;
}


sub blacklistExit {
    my $f = shift;
    my $key = shift;
    my @fields = qw(REASON Notes MAC StartTime ClearInfo ClientId);
    my %rec;

    return unless $key eq "\n";

    if ($f->getWidget('Buttons')->getField('VALUE') == 1) {
        $app->delForm('Blacklist');
        $w = $app->getForm('Main')->getWidget('lstAuth');
        $app->execute;
        return;
    }

    $rec{$_} = $f->getWidget($_)->getField('VALUE') for @fields;

    unless ($rec{REASON} && $rec{Notes}) {
        dialog('Error!', BTN_OK, 'Reason & Notes are required!', qw(white red yellow));
        return;
    }

    unless ($Options::dbh_dbase && $Options::dbh_host && $Options::dbh_pass && $Options::dbh_user &&
            $Options::ptc_dbase && $Options::ptc_host && $Options::ptc_pass && $Options::ptc_user) {
        dialog('Error!', BTN_OK, 'Database settings not configured!', qw(white red yellow));
        return;
    }

    our $main::dbh_hpna = DBI->connect("DBI:mysql:$Options::dbh_dbase:$Options::dbh_host",
                                        $Options::dbh_user, $Options::dbh_pass);
    our $main::dbh_ptc = DBI->connect("DBI:mysql:$Options::ptc_dbase:$Options::ptc_host",
                                       $Options::ptc_user, $Options::ptc_pass);

    if ($rec{StartTime}) {
        # Clear existing blacklist entry
        $rv = dialog('Clear Blacklist?', BTN_YES | BTN_NO,
                     'Are you sure you want to clear?', qw(white red yellow));
        return if $rv;

        unless ($rec{REASON} && $rec{Notes} && $rec{ClearInfo}) {
            dialog('Error!', BTN_OK, 'Reason, Notes & Clear Info are required!',
                   qw(white red yellow));
            return;
        }

        closeBlackListDB($rec{MAC}, $rec{REASON}, $rec{StartTime}, $rec{ClearInfo});
    } else {
        # Add new blacklist entry
        my $msg = addBlackListDB($rec{MAC}, $rec{REASON}, $rec{Notes}, $main::region, $rec{ClientId});

        if ($msg eq 1) {
            dialog('Added', BTN_OK, "Added $rec{ClientId}/$rec{MAC} to blacklist!",
                   qw(white red yellow));
            my $ptc_home = get_config()->{home};
            open(my $fh, '>>', "$ptc_home/tmp/clearList");
            print $fh "CLEARING:N/A:$rec{MAC}:N/A:::\n";
            close($fh);
        } else {
            dialog('Error!', BTN_OK, "Failed: $$msg", qw(white red yellow));
            return;
        }
    }

    $app->delForm('Blacklist');
    $w = $app->getForm('Main')->getWidget('lstAuth');
    $app->execute;
    $selected = 0;
}


sub arping_stats {
    my ($clientid, $device, $ip, $mac) = @_;
    my $arping = "/usr/bin/arping";

    return unless $opts{'s'} && $opts{'a'};
    return unless -e $arping;
    return unless $device =~ /eth/;

    print "Checking $ip on $device (MAC: $mac)\n" if $debug > 0;

    my ($total, $count, $pl) = (0, 0, 0);
    my @results = `$arping -I $device $ip -w 100000 -c 5 2>/dev/null`;

    for (@results) {
        if (/.*,\s+(\d+)\%\s+unanswered/) {
            $pl = $1;
        } elsif (/time=(\d+\.\d+)/) {
            $total += $1;
            $count++;
        }
    }

    return unless $count > 0;

    (my $mac_clean = $mac) =~ s/://g;
    my $avg = $total / $count;
    print "UPDATING $clientid avg=${avg}s PL=${pl}%\n" if $debug > 0;

    eval {
        my $info = virtual RRD::Info("$clientid-$mac_clean",
            "Checking $clientid $ip on $device", "arpingStats");
        my $current_time = gettimeofday() if $opts{p};
        $info->CheckPathsVirtual($1);
        $info->{Function}->Update($avg, $pl);

        if ($opts{g}) {
            for my $period (['1hour', -7200], ['1day', -86400], ['1week', -604800],
                            ['8weeks', -4838400], ['2years', -63072000]) {
                $info->{Function}->Graph("$clientid-arp-$period->[0]", $period->[1]);
            }
        }

        if ($opts{p}) {
            my $diff = gettimeofday() - $current_time;
            printf "%.3f arping\n", $diff;
        }
    };
    warn "RRD error: $@" if $@ && $debug > 0;
}




sub logexit {
    my $f = shift;
    my $key = shift;
    $w = $f->getWidget('htmlLOG');

    if (lc($key) eq "h" || lc($key) eq "u") {
        $f->setField(DONTSWITCH => 1);
        showLog($w);
    }
}


