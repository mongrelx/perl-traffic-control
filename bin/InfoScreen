sub srcexit {
    my $f = shift;
    my $key = shift;
    $w = $f->getWidget('lstConn');

    my %actions = (
        "\n" => sub { $f->setField(DONTSWITCH => 1); showdetails($w); },
        "q"  => sub { $view = ''; $database = 0; $f->setField(DONTSWITCH => 1); updateList($w, $view); },
        "u"  => sub { $f->setField(DONTSWITCH => 1); updateList($w, $view, $database); },
        "o"  => sub {
            $f->setField(DONTSWITCH => 1);
            $current_order = ($current_order + 1) % ($MAX_TABS + 1);
            updateList($w, $view);
        },
        "h"  => sub {
            $f->setField(DONTSWITCH => 1);
            my $ref = loadUnknownHost();
            @tmp2 = @$ref if ref $ref eq 'ARRAY';
            $view = "unknown";
            $w->setField(
                CAPTION   => "Found: " . scalar(@tmp2) . " $main::users_string",
                LISTITEMS => [@tmp2],
            );
            $app->execute;
        },
        "r"  => sub {
            $f->setField(DONTSWITCH => 1);
            my $ref = loadUnknownHost();
            @tmp2 = @$ref if ref $ref eq 'ARRAY';
            $view = "unknown";
            $w->setField(
                CAPTION   => "Found: " . scalar(@tmp2) . " $main::users_string",
                LISTITEMS => [@tmp2],
            );
            $app->execute;
        },
        "a"  => sub { showAAALog($w); },
        "i"  => sub { showInterfaces($w); },
        "e"  => sub { editInfo($w); },
        "?"  => sub { $f->setField(DONTSWITCH => 1); showHelp($w); },
        "c"  => sub { $f->setField(DONTSWITCH => 1); clearAuth($w); },
        "s"  => sub { $f->setField(DONTSWITCH => 1); searchItem($w); },
        "x"  => sub { $dbh_ptc->disconnect(); exit; },
    );

    my $lc_key = lc($key);
    if (exists $actions{$lc_key}) {
        $actions{$lc_key}->();
    } elsif (exists $actions{$key}) {
        $actions{$key}->();
    }
}

