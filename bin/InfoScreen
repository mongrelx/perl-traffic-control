    my $f = shift;
    @tmp2 = `tail -n $l /var/log/AAA.html 2>/dev/null | grep -e mac -e Auth`;

    $w = $app->getForm('Main')->getWidget('htmlLOG');
    $w->setField(
        CAPTION   => "Log entries: " . scalar(@tmp2),
