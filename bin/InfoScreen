#!/usr/bin/perl

use strict;
use warnings;
use LWP::Simple;
use JSON qw( decode_json );
use Data::Dumper;
use Try::Tiny;
use Curses::Application;
use FindBin;
use lib "$FindBin::Bin/../lib";
use DBI;
use PTC::Authen;
use PTC::Device;
use PTC::Utils;
use PTC::NetUtils;
use PTC::Info;
use PTC::Config;
use POSIX;
use DirHandle;
use POSIX ":sys_wait_h";
use Getopt::Std;

my $clock_count = 0;
my $selected = 0;

#####################################################################
#
# Set up the environment
#
#####################################################################

our $VERSION = "2.0";
our $main::distribution = "debian";
$VERSION .= " $main::distribution";

my @Current = ("N/A");
my @Auth = ("N/A");
my @configs;
my $current_order = 0;
my $MAX_TABS = 7;
my $view = '';
our %main::class = ();
our %main::status = ();
our %main::QoSDevice = ();
our $main::nat = 1;
our $main::nat_device = "ifb0";

my $mode = 10;
our $main::users_string = "";
my $database = 0;

my %opts;
getopts('spga', \%opts);

$opts{'a'} //= 1;

if ($opts{'s'}) {
    require RRDTool::OO;
    require Time::HiRes;
    Time::HiRes->import(qw(usleep gettimeofday));
}

#####################################################################
#
# Program Logic starts here
#
#####################################################################

our $main::debug = 1;
my $debug = $main::debug;

PTC::Utils::loadConfig();
my $dbh_ptc = get_dbh();

PTC::Utils::setQoSDevice();
loaddir($current_order);
my ($app, $f, $w, $rv);
my ($cw, $l, @tmp, $d, @tmp2);

chomp($d = `pwd`);

my $ref_tmp = loaddir($current_order);
@tmp2 = @$ref_tmp if ref $ref_tmp eq 'ARRAY';

if ($opts{'s'}) {
    foreach my $row (@tmp2) {
        print "$row->[4] $row->[5] $row->[6]\n" if $opts{x};
        $row->[4] =~ m#(\d+)\/.*#;
        my $clientid = $1;

        next unless defined $clientid && $clientid =~ /\d+/;

        if ($opts{'s'} && $opts{'a'}) {
            my @info = split('/', $row->[0]);
            arping_stats($clientid, $info[1], $row->[1], $row->[2]);
        }

        $row->[5] =~ m#(\d+).*\/(\d+)#;
        my ($inb, $inp) = ($1, $2);

        $row->[6] =~ m#(\d+).*\/(\d+)#;
        my ($outb, $outp) = ($1, $2);

        my $info = virtual RRD::Info($clientid, $row->[4]);
        my $current_time = gettimeofday() if $opts{p};
        $info->CheckPathsVirtual($1);

        unless (defined $inb && defined $inp && defined $outb && defined $outp) {
            print "NO VALUES FOR $clientid\n" if $debug > 0;
            next;
        }

        print "UPDATING $clientid $inb/$inp $outb/$outp\n" if $debug > 0;
        my $rrd;
        $rrd->update(
            time   => $current_time,
            values => { inb => $inb, inp => $inp, outb => $outb, outp => $outp }
        );

        if ($opts{g}) {
            for my $period (['1hour', -7200], ['1day', -86400], ['1week', -604800],
                            ['8weeks', -4838400], ['2years', -63072000]) {
                $info->{Function}->Graph("$clientid-$period->[0]", $period->[1]);
            }
        }

        if ($opts{p}) {
            my $diff = gettimeofday() - $current_time;
            printf "%.3f clientStats\n", $diff;
            if (my $r = $info->{Function}->{LastRead}) {
                print "Results: $r\nDone in $diff\n";
            } else {
                print "No results found, recheck config!\n";
            }
        }
    }
}
else {
    $app = Curses::Application->new({
        FOREGROUND => 'white',
        BACKGROUND => 'blue',
        CAPTIONCOL => 'yellow',
        TITLEBAR   => 1,
        CAPTION    => "PTC Router v$VERSION",
        MAINFORM   => { Main => 'MainFrm' },
        INPUTFUNC  => \&myscankey,
    });

    $cw = int(($app->maxyx)[1]) - 2;
    $l  = ($app->maxyx)[0] - 5;

    $app->createForm(qw(Main MainFrm));
    $w = $app->getForm('Main')->getWidget('lstConn');
    @tmp = @{$w->getField('COLWIDTHS')};
    $w->setField(
        CAPTION   => "Connected: " . scalar(@tmp2) . " $main::users_string",
        LINES     => $l - 1,
        COLUMNS   => $cw,
        LISTITEMS => [@tmp2],
        COLWIDTHS => [@tmp],
        CWD       => $d,
    );

    # Build network menu dynamically
    my %net_menu;
    my @netmenu_items;
    foreach my $network (sort keys %Options::network) {
        push @netmenu_items, $network;
        $net_menu{$network} = \&main::show;
    }
    $net_menu{ITEMORDER} = [@netmenu_items];

    $w = $app->getForm('Main')->getWidget('Menu');
    $w->setField(
        MENUS => {
            MENUORDER => [qw(File Show Network Tools)],
            Network   => \%net_menu,
        }
    );

    $app->execute;
    $dbh_ptc->disconnect();
    exit 0;
}

#####################################################################
#
# Subroutines follow here
#
#####################################################################

sub show {
    my $network = shift;
}


sub myscankey {
    my $mwh = shift;
    my $key = -1;

    while ($key eq -1) {
        clockUpdate();
        $key = $mwh->getch;
    }

    return $key;
}

sub clockUpdate {
    if ($clock_count < 100 && $selected == 0) {
        sleep(0.5);
        my $time = `uptime`;
        chomp $time;
        my $x = ($app->maxyx)[1] - length($time);
        my $caption = substr($app->getField('CAPTION'), 0, $x);
        $caption .= ' ' x ($x - length($caption)) . $time;
        $app->titlebar($caption);
        $clock_count = 150;
    } else {
        sleep(0.5);
        $clock_count--;
    }
}

sub quit {
    $rv = dialog('Quit Application?', BTN_YES | BTN_NO,
                 'Are you sure you want to quit?', qw(white red yellow));
    $dbh_ptc->disconnect();
    exit 0 unless $rv;
}





sub loadUnknownHost {
    my @rv;
    my ($nan, $auth, $redir) = (0, 0, 0);
    my $file_msg = '';
    my $ptc_home = get_config()->{home};
    my $online_file = "$ptc_home/tmp/unknown_hosts";

    if (-e $online_file) {
        my @stat = stat($online_file);
        $file_msg = time - $stat[9];
        $file_msg = "Check daemon\n" if (time - $stat[9]) > 300;

        open(my $fh, '<', $online_file);
        while (<$fh>) {
            chomp;
            push @rv, $_;
        }
        close($fh);

        @rv = map {
            my @temp = split(":", $_);
            for my $i (0..12) {
                $temp[$i] //= "N/A";
            }
            my $str = "$temp[2]:$temp[3]:$temp[4]:$temp[5]:$temp[6]:$temp[7]";
            $main::status{$str}{ip} = $temp[1];
            [$temp[0], $temp[1], $str];
        } sort @rv;
    }

    $main::users_string = "(last update: ${file_msg}s) Not auth: $nan Auth: $auth Redirected: $redir";
    return \@rv;
}


sub updateList {
    my $w = shift;
    my $search = shift;
    my $ref_tmp;

    if (defined $search && $search ne '') {
        $ref_tmp = loaddir($current_order, $search, 1, $database);
    } else {
        $ref_tmp = loaddir($current_order);
    }

    if (ref $ref_tmp eq 'ARRAY') {
        @tmp2 = @$ref_tmp;
        $w->setField(
            LISTITEMS => [@tmp2],
            CAPTION   => 'Connected ' . scalar(@tmp2) . " $current_order $main::users_string",
        );
    }
}

sub updateLog {
    my $w = shift;
    my $ref_tmp = loaddir($current_order);

    if (ref $ref_tmp eq 'ARRAY') {
        @tmp2 = @$ref_tmp;
        $w->setField(
            LISTITEMS => [@tmp2],
            CAPTION   => 'UPDATE ' . scalar(@tmp2) . " $main::users_string",
        );
    }
}

sub DEBUG {
    my $msg = shift;
    open(my $fh, '>>', 'debug.log');
    print $fh "$msg\n";
    close($fh);
}


sub showdetails {
    my $f = shift;
    $selected = 1;

    my @items = @{$f->getField('LISTITEMS')};
    my $rec = $items[$f->getField('CURSORPOS')];
    my @info = @$rec[0,1,2,3,4,5,6,7];

    $app->createForm('Details', 'DetailsFrm');
    $w = $app->getForm('Details');

    # Populate basic fields
    my @fields = qw(STATUS IP MAC SPEED CLIENT);
    for my $i (0..$#fields) {
        $w->getWidget($fields[$i])->setField(VALUE => "$info[$i]") if defined $info[$i];
    }

    # Show redirect status
    $w->getWidget("REDIRECT")->setField(VALUE => "$main::status{$info[2]}{redirect}");

    unless ($main::status{$info[2]}{redirect}) {
        $w->getWidget("INCLASS")->setField(VALUE => "$main::status{$info[2]}{inclass}");
        $w->getWidget("OUTCLASS")->setField(VALUE => "$main::status{$info[2]}{outclass}");

        if ($main::status{$info[2]}{inclass} ne "NOQOS") {
            my $in_class = $main::status{$info[2]}{inclass};
            my $out_class = $main::status{$info[2]}{outclass};
            if (defined $main::class{$in_class}{bytes}) {
                $w->getWidget("INTRAFFIC")->setField(VALUE =>
                    "$main::class{$in_class}{bytes} bytes $main::class{$in_class}{pkts} pkts");
                $w->getWidget("OUTTRAFFIC")->setField(VALUE =>
                    "$main::class{$out_class}{bytes} bytes $main::class{$out_class}{pkts} pkts");
            }
        }
    }

    # Fetch MAC vendor info
    chomp($info[2]);
    my $url = "https://macvendors.co/api/$info[2]";
    eval {
        require LWP::UserAgent;
        require HTTP::Request;
        my $ua = LWP::UserAgent->new(agent => "PTC/2.0", timeout => 5);
        my $response = $ua->get($url);
        if ($response->is_success) {
            my $json = JSON->new->utf8->decode($response->content);
            if ($json->{result}{company}) {
                $w->getWidget("INFO")->setField(VALUE => "VENDOR: $json->{result}{company}");
            }
        }
    };
    $w->getWidget("INFO")->setField(VALUE => "VENDOR: lookup failed") if $@;

    $app->execForm('Details');
}

sub editInfo {
    my $f = shift;
    $selected = 1;

    my @items = @{$f->getField('LISTITEMS')};
    my $rec = $items[$f->getField('CURSORPOS')];
