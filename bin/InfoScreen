    $w->getWidget("REDIRECT")->setField(VALUE => "$main::status{$info[2]}{redirect}");
    $w->getWidget("FilterId")->setField(VALUE => "$main::status{$info[2]}{speed}");
    $w->getWidget("RadReply")->setField(VALUE => "$main::status{$info[2]}{customer}");

    $app->execForm('Edit');
}

