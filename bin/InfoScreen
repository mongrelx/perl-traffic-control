}

sub detailsexit {
    my $f = shift;
    my $key = shift;
    $selected = 0;

    if ($key eq "\n") {
        if ($f->getWidget('Buttons')->getField('VALUE') == 0) {
            $app->delForm('Details');
            $w = $app->getForm('Main')->getWidget('lstAuth');
            $app->execute;
        } else {
            $f->setField(DONTSWITCH => 1);
            updateList($w);
        }
    }
}

